@{
    ViewBag.Title = "Giới thiệu";
    ViewData["Header"] = "Giới Thiệu Quán & Nhóm Phát Triển";
}

<div style="max-width: 960px; margin: 20px auto;">
    <!-- Card Giới thiệu quán -->
    <div class="modern-card" style="margin-bottom: 25px;">
        <div style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
            <img src="~/images/logo.png" alt="Logo" style="width: 90px; height: 90px; border-radius: 20px; box-shadow: var(--shadow-soft);" />
            <div style="flex: 1; min-width: 260px;">
                <h2 style="font-size: 26px; margin: 0 0 6px 0; color: var(--primary-espresso);">☕ Quán Cà Phê Los Seymanos Emirhanos</h2>
                <div style="color: var(--accent-caramel); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">
                    Hệ thống đặt món & Quản lý Barista thông minh
                </div>
            </div>
        </div>

        <p style="margin-top: 18px; font-size: 15.5px; color: var(--text-secondary); line-height: 1.7;">
            <strong>Los Seymanos Emirhanos</strong> là ứng dụng web hiện đại xây dựng trên nền tảng ASP.NET Core MVC, 
            kết hợp hoàn hảo giữa trải nghiệm đặt món trực quan tại bàn cho <strong>khách hàng</strong> và hệ thống điều hành pha chế, 
            quản trị thực đơn thông minh cho <strong>Barista</strong>. Tên thương hiệu được lấy cảm hứng sáng tạo từ sự kết hợp đặc biệt 
            của những người sáng lập dự án.
        </p>
    </div>

    <!-- Card Thành viên nhóm -->
    <div class="modern-card" style="padding: 0; overflow: hidden; margin-bottom: 25px;">
        <div style="padding: 20px 28px; border-bottom: 1px solid var(--border-color);">
            <h3 style="font-size: 20px; margin: 0; color: var(--primary-espresso);">👥 Thành Viên & Vai Trò Dự Án (Nhóm 02)</h3>
            <p style="margin: 4px 0 0 0; font-size: 13.5px; color: var(--text-secondary);">Đội ngũ phát triển và duy trì hệ thống ứng dụng</p>
        </div>

        <div class="table-responsive">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th style="width: 220px;">Thành viên</th>
                        <th style="width: 150px; text-align: center;">Vai trò</th>
                        <th>Phụ trách chính</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong style="color: var(--primary-mocha); font-size: 15px;">Trần Tuấn Hưng</strong>
                        </td>
                        <td style="text-align: center;">
                            <span class="badge-custom badge-danger">Leader</span>
                        </td>
                        <td style="color: var(--text-secondary);">Quy trình dự án, README, Việt hóa toàn diện giao diện, báo cáo</td>
                    </tr>
                    <tr>
                        <td>
                            <strong style="color: var(--primary-mocha); font-size: 15px;">Nguyễn Xuân Trường</strong>
                        </td>
                        <td style="text-align: center;">
                            <span class="badge-custom badge-warning">Maintainer</span>
                        </td>
                        <td style="color: var(--text-secondary);">Cấu hình repo, CI, CONTRIBUTING, giấy phép và phát hành</td>
                    </tr>
                    <tr>
                        <td>
                            <strong style="color: var(--primary-mocha); font-size: 15px;">Trần Minh Đính</strong>
                        </td>
                        <td style="text-align: center;">
                            <span class="badge-custom badge-info">Contributor</span>
                        </td>
                        <td style="color: var(--text-secondary);">Dự án test, trang Giới thiệu, hoàn thiện chân trang</td>
                    </tr>
                    <tr>
                        <td>
                            <strong style="color: var(--primary-mocha); font-size: 15px;">Nguyễn Thái Phú</strong>
                        </td>
                        <td style="text-align: center;">
                            <span class="badge-custom badge-success">Dev-core 1</span>
                        </td>
                        <td style="color: var(--text-secondary);">Tìm kiếm món, kiểm tra biểu mẫu (Validation), thống kê doanh thu</td>
                    </tr>
                    <tr>
                        <td>
                            <strong style="color: var(--primary-mocha); font-size: 15px;">Trần Dương Phong</strong>
                        </td>
                        <td style="text-align: center;">
                            <span class="badge-custom badge-success">Dev-core 2</span>
                        </td>
                        <td style="color: var(--text-secondary);">Sắp xếp món, hệ thống thông báo thành công, dọn dẹp mã nguồn</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div>
        <a class="btn-coffee-secondary" asp-controller="Home" asp-action="Index">
            ← Quay về Trang chủ
        </a>
    </div>
</div>
