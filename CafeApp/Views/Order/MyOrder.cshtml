@model Tuple<Order, List<Product>, List<int>, Dictionary<int, int>>

@{
    ViewData["Header"] = "Đơn Hàng Của Bạn";
    ViewBag.Title = "Thông tin đơn hàng";
}

<div style="max-width: 760px; margin: 20px auto;">
    <!-- Thông báo trạng thái -->
    <div class="custom-alert alert-success" style="margin-bottom: 25px;">
        <div class="alert-icon" style="font-size: 24px;">🎉</div>
        <div class="alert-content">
            <span class="alert-title">Đặt món thành công!</span>
            <span class="alert-text">Đơn hàng của quý khách đã được chuyển tới quầy pha chế và sẽ được phục vụ trong ít phút.</span>
        </div>
    </div>

    <!-- Hóa Đơn Chi Tiết -->
    <div class="modern-card" style="padding: 32px;">
        <!-- Header Phiếu -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1.5px dashed var(--border-color); padding-bottom: 20px; flex-wrap: wrap; gap: 14px;">
            <div>
                <span class="badge-custom badge-table" style="font-size: 15px; margin-bottom: 8px;">
                    Bàn số @Model.Item1.TableNo
                </span>
                <h2 style="font-size: 24px; margin: 4px 0; color: var(--primary-espresso);">@Model.Item1.CustomerName</h2>
                <div style="font-size: 13.5px; color: var(--text-secondary);">
                    Mã đơn hàng: <strong>#@Model.Item1.OrderId</strong> &bull; 
                    Giờ đặt: <strong>@Model.Item1.OrderDate.ToString("HH:mm - dd/MM/yyyy")</strong>
                </div>
            </div>

            <div style="text-align: right;">
                <div style="font-size: 13px; color: var(--text-secondary); text-transform: uppercase; font-weight: 700;">Tổng thanh toán</div>
                <div style="font-size: 32px; font-weight: 800; color: #A8202A;">$@Model.Item1.TotalPrice</div>
            </div>
        </div>

        <!-- Trạng thái tiến độ -->
        <div style="margin: 22px 0; display: flex; gap: 14px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 200px; background: #FAF7F2; padding: 14px 18px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 4px;">Tiến độ pha chế</span>
                @if (Model.Item1.IsServed)
                {
                    <span class="badge-custom badge-success" style="font-size: 14px;">
                        <span>✓</span> Đã phục vụ tại bàn
                    </span>
                }
                else
                {
                    <span class="badge-custom badge-warning" style="font-size: 14px;">
                        <span>⏳</span> Đang được Barista chuẩn bị
                    </span>
                }
            </div>

            <div style="flex: 1; min-width: 200px; background: #FAF7F2; padding: 14px 18px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 4px;">Tình trạng thanh toán</span>
                @if (Model.Item1.IsPaid)
                {
                    <span class="badge-custom badge-success" style="font-size: 14px;">
                        <span>✓</span> Đã hoàn tất thanh toán
                    </span>
                }
                else
                {
                    <span class="badge-custom badge-danger" style="font-size: 14px;">
                        <span>💳</span> Thanh toán sau khi dùng bữa
                    </span>
                }
            </div>
        </div>

        <!-- Bảng món đã chọn -->
        <div style="margin: 25px 0;">
            <h3 style="font-size: 17px; margin-bottom: 14px; color: var(--primary-mocha);">
                ☕ Các Món Quý Khách Đã Gọi
            </h3>
            <table class="table-modern" style="border: 1px solid var(--border-color); border-radius: var(--radius-md);">
                <thead>
                    <tr>
                        <th>Tên món</th>
                        <th style="text-align: center; width: 100px;">Số lượng</th>
                        <th style="text-align: right; width: 120px;">Đơn giá</th>
                        <th style="text-align: right; width: 140px;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Item2)
                    {
                        var quantity = Model.Item4.ContainsKey(product.ProductId) ? Model.Item4[product.ProductId] : 0;
                        var subtotal = (product.Price ?? 0) * quantity;
                        <tr>
                            <td>
                                <strong style="color: var(--primary-mocha);">@product.Name</strong>
                            </td>
                            <td style="text-align: center;">
                                <span class="badge-custom badge-info">@quantity</span>
                            </td>
                            <td style="text-align: right; color: var(--text-secondary);">
                                $@product.Price
                            </td>
                            <td style="text-align: right; font-weight: 700; color: #A8202A;">
                                $@subtotal
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Các Nút Thao Tác -->
        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1.5px dashed var(--border-color); padding-top: 22px; flex-wrap: wrap; gap: 12px;">
            <a asp-controller="Order" asp-action="Create" class="btn-coffee-secondary">
                <span>➕</span> Gọi thêm món khác
            </a>

            <div style="display: flex; gap: 10px;">
                @if (!Model.Item1.IsServed)
                {
                    <a asp-controller="Order" asp-action="Edit" asp-route-id="@Model.Item1.OrderId" 
                       class="btn-coffee-primary" style="padding: 10px 20px;">
                        <span>✏️</span> Chỉnh sửa đơn
                    </a>
                }
                <a asp-controller="Order" asp-action="Delete" asp-route-id="@Model.Item1.OrderId" 
                   class="btn-coffee-danger" style="padding: 10px 18px;">
                    <span>✕</span> Hủy đơn
                </a>
            </div>
        </div>
    </div>
</div>
