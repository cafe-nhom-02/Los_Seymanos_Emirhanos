@model CafeApp.Models.Order

@{
    ViewData["Header"] = "Hủy Đơn Hàng";
    ViewBag.Title = "Xác nhận hủy đơn";
}

<div style="max-width: 520px; margin: 40px auto;">
    <div class="modern-card" style="text-align: center; padding: 40px 30px;">
        <div style="width: 72px; height: 72px; border-radius: 50%; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 36px; margin: 0 auto 20px auto;">
            🗑️
        </div>

        <h2 style="font-size: 22px; margin-bottom: 12px; color: var(--primary-espresso);">
            Quý khách có chắc chắn muốn hủy đơn hàng?
        </h2>

        <p style="color: var(--text-secondary); font-size: 15px; margin-bottom: 24px; line-height: 1.5;">
            Đơn hàng tại <strong>Bàn @(Model.TableNo?.ToString() ?? "-")</strong> của quý khách <strong>@(Model.CustomerName ?? "Quý khách")</strong> 
            với tổng số tiền <strong>$@Model.TotalPrice</strong> sẽ bị hủy và không được chế biến nữa.
        </p>

        <form asp-action="Delete" method="post" style="display: flex; gap: 14px; justify-content: center;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" asp-for="OrderId" />
            
            <a href="/Order/MyOrder?id=@Model.OrderId" class="btn-coffee-secondary" style="flex: 1; max-width: 170px;">
                Không, giữ đơn
            </a>
            <button type="submit" class="btn-coffee-danger" style="flex: 1; max-width: 170px;">
                <span>✕</span> Xác nhận hủy
            </button>
        </form>
    </div>
</div>
