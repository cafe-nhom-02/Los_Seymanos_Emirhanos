@{
    ViewData["Header"] = "Hủy Đơn Hàng Thành Công";
    ViewBag.Title = "Đã hủy đơn";
}

<div style="max-width: 540px; margin: 40px auto;">
    <div class="modern-card" style="text-align: center; padding: 45px 30px;">
        <div style="width: 76px; height: 76px; border-radius: 50%; background: #E8F8F0; color: #16A34A; display: flex; align-items: center; justify-content: center; font-size: 38px; margin: 0 auto 20px auto;">
            ✓
        </div>

        <h2 style="font-size: 24px; margin-bottom: 12px; color: var(--primary-espresso);">
            Đơn hàng đã được hủy thành công
        </h2>

        <p style="color: var(--text-secondary); font-size: 15px; margin-bottom: 28px; line-height: 1.6;">
            Cảm ơn quý khách. Quý khách có thể xem lại thực đơn và chọn cho mình những món đồ uống, món tráng miệng khác bất cứ lúc nào!
        </p>

        <a href="/Order/Create" class="btn-coffee-primary" style="padding: 13px 32px; font-size: 16px;">
            <span>☕</span> Tạo đơn hàng mới
        </a>
    </div>
</div>
