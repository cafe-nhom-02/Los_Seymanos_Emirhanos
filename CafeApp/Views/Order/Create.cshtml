@model Tuple<List<Product>, Order>

@{
    ViewData["Header"] = "Thưởng Thức Cà Phê Của Bạn";
    ViewBag.Title = "Thực đơn & Đặt món";
}

<link rel="stylesheet" href="~/css/createProduct.css" asp-append-version="true">

<!-- Thanh Tìm Kiếm & Bộ Lọc Nâng Cao -->
<div class="modern-card" style="padding: 16px 24px; margin-bottom: 25px;">
    <form asp-action="Create" method="get" style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; width: 100%;">
        <input type="hidden" name="orderId" value="@Model.Item2.OrderId" />

        <!-- Ô Tìm kiếm -->
        <div style="flex: 1; min-width: 220px; position: relative;">
            <input type="text"
                   name="searchString"
                   value="@ViewBag.SearchString"
                   class="loginInput"
                   placeholder="🔍 Tìm kiếm món cà phê, đồ uống, bánh..."
                   style="padding-left: 14px;" />
        </div>

        <!-- Bộ lọc sắp xếp -->
        <div style="width: 180px;">
            <select name="sortOrder"
                    class="loginInput"
                    style="cursor: pointer;"
                    onchange="this.form.submit()">
                <option value="">-- Sắp xếp --</option>
                <option value="price_asc" selected="@(ViewBag.SortOrder == "price_asc")">Giá tăng dần</option>
                <option value="price_desc" selected="@(ViewBag.SortOrder == "price_desc")">Giá giảm dần</option>
                <option value="name_asc" selected="@(ViewBag.SortOrder == "name_asc")">Tên món A-Z</option>
            </select>
        </div>

        <!-- Nút Tìm kiếm -->
        <button type="submit" class="btn-coffee-primary" style="padding: 10px 20px;">
            Tìm kiếm
        </button>

        <!-- Nút Đặt lại khi có filter -->
        @if (!string.IsNullOrEmpty(ViewBag.SearchString as string) || !string.IsNullOrEmpty(ViewBag.SortOrder as string))
        {
            <a asp-action="Create" asp-route-orderId="@Model.Item2.OrderId" class="btn-coffee-secondary" style="padding: 10px 18px;">
                <span>✕</span> Đặt lại
            </a>
        }
    </form>
</div>

<div class="Wrapper">
    <!-- Cột Trái: Lưới Sản Phẩm -->
    <div class="productsContainer">
        @if (!Model.Item1.Any())
        {
            <div class="modern-card" style="text-align: center; padding: 60px 20px;">
                <div style="font-size: 48px; margin-bottom: 14px;">🔍</div>
                <h3 style="font-size: 20px; color: var(--text-secondary); margin-bottom: 6px;">Không tìm thấy món ăn phù hợp</h3>
                <p style="color: var(--text-muted); font-size: 14px;">Hãy thử tìm kiếm với từ khóa khác hoặc bấm "Đặt lại" để xem toàn bộ thực đơn.</p>
            </div>
        }
        else
        {
            <div id="ProductsList">
                @foreach (var product in Model.Item1)
                {
                    <div id="product_@product.ProductId" class="product" style="background-image: url('@(Url.Content(product.ImageSrc ?? "~/images/logo.png"))');">
                        <div class="productInfo">
                            <p>@product.Name</p>
                            <p class="pricep">$ @product.Price</p>
                        </div>
                        <div class="filter"></div>
                        <div class="controlBag">
                            <button type="button"
                                    onclick="removeFromBag(@product.ProductId, @Model.Item2.OrderId, '@Html.Raw(product.Name)', @product.Price);"
                                    class="bagButton" disabled title="Giảm số lượng">-</button>
                            <input id="quantityInput_@product.ProductId" value="0" type="number" readonly />
                            <button type="button"
                                    onclick="addToBag(@product.ProductId, @Model.Item2.OrderId, '@Html.Raw(product.Name)', @product.Price);"
                                    class="bagButton" disabled title="Tăng số lượng">+</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Cột Phải: Form Thông Tin & Hóa Đơn -->
    <div class="right">
        <div id="OrderForm">
            <h3>Thông Tin Đặt Bàn</h3>
            
            <div id="orderValidationError" class="validation-error mb-3" style="display: none; padding: 10px; background: #FEE2E2; border-radius: 8px; border: 1px solid #FECACA;"></div>

            <form class="form" asp-controller="Order" asp-action="Create" method="post" onsubmit="return checkOrderForm()">
                @Html.AntiForgeryToken()
                <input asp-for="Item2.OrderId" type="hidden" name="orderId" value="@Model.Item2.OrderId" />
                <input asp-for="Item2.TotalPrice" type="hidden" id="totalPrice" name="totalPrice" value="0" />

                <div class="form-group-order">
                    <label for="tableNo">Số bàn của bạn *</label>
                    <input class="loginInput" id="tableNo" name="tableNo" type="number" min="1" required placeholder="Nhập số bàn (ví dụ: 5)" />
                </div>

                <div class="form-group-order">
                    <label for="customerName">Tên quý khách *</label>
                    <input class="loginInput" id="customerName" name="customerName" type="text" maxlength="50" required placeholder="Nhập họ tên quý khách" />
                </div>

                <button class="orderButton" type="submit" style="margin-top: 14px;">
                    <span>☕</span> Xác Nhận Đặt Món
                </button>
            </form>
        </div>

        @await Html.PartialAsync("../Shared/_OrderDetails")
    </div>
</div>

<script>
    // Bật các nút thêm món sau khi trang sẵn sàng
    setTimeout(function () {
        document.querySelectorAll('.bagButton').forEach(b => b.removeAttribute('disabled'));
    }, 500);

    function UpdateDBBefore() {
        $.ajax({
            type: "POST",
            url: "/Order/UpdateDBBefore",
            data: { orderId: @Model.Item2.OrderId },
            success: function () { },
            error: function () { }
        });
    }

    window.addEventListener('beforeunload', UpdateDBBefore);

    function addToBag(productId, orderId, productName, productPrice) {
        $.ajax({
            type: "POST",
            url: "/Order/AddToBag",
            data: { productId: productId, orderId: orderId },
            success: function (response) {
                printOrderDetails(productName, productPrice, response.quantity, productId);
                updateQuantityInput(productId, response.quantity);
                hideEmptyBagNotice();
            },
            error: function () { }
        });
    }

    function removeFromBag(productId, orderId, productName, productPrice) {
        $.ajax({
            type: "POST",
            url: "/Order/RemoveFromBag",
            data: { productId: productId, orderId: orderId },
            success: function (response) {
                printOrderDetails(productName, productPrice, response.quantity, productId);
                updateQuantityInput(productId, response.quantity);
            },
            error: function () { }
        });
    }

    function updateQuantityInput(productId, quantity) {
        var quantityInput = document.getElementById("quantityInput_" + productId);
        if (quantityInput) {
            quantityInput.value = quantity;
        }
    }

    var addedProducts = [];

    function hideEmptyBagNotice() {
        var notice = document.getElementById("emptyBagNotice");
        if (notice) notice.style.display = "none";
    }

    function showEmptyBagNoticeIfNeeded() {
        var notice = document.getElementById("emptyBagNotice");
        if (notice && addedProducts.length === 0) {
            notice.style.display = "block";
        }
    }

    function printOrderDetails(name, price, quantity, productId) {
        var table = document.querySelector("#tbl tbody") || document.querySelector("#tbl");

        if (!addedProducts.includes(name) && quantity > 0) {
            var tableRow = document.createElement("tr");
            tableRow.id = productId * 100;
            tableRow.classList.add("addedRow");

            var nameElement = document.createElement("td");
            nameElement.textContent = name;
            nameElement.classList.add("nameElement");

            var quantityElement = document.createElement("td");
            quantityElement.id = `${productId}`;
            quantityElement.textContent = quantity + "x";
            quantityElement.classList.add("quantityElement");

            var priceElement = document.createElement("td");
            priceElement.id = `${productId * 10}`;
            priceElement.classList.add("price");
            priceElement.textContent = `$ ${price * quantity}`;

            tableRow.appendChild(nameElement);
            tableRow.appendChild(quantityElement);
            tableRow.appendChild(priceElement);
            table.appendChild(tableRow);

            addedProducts.push(name);
        }
        else if (quantity > 0) {
            var quantityElement = document.getElementById(`${productId}`);
            var priceElement = document.getElementById(`${productId * 10}`);

            if (quantityElement) quantityElement.textContent = quantity + "x";
            if (priceElement) priceElement.textContent = `$ ${price * quantity}`;
        }
        else if (quantity <= 0) {
            var tableRow = document.getElementById(productId * 100);
            if (tableRow) tableRow.remove();

            var index = addedProducts.indexOf(name);
            if (index !== -1) {
                addedProducts.splice(index, 1);
            }
        }

        // Tính tổng tiền
        var total = document.getElementById("total");
        var allPrices = document.querySelectorAll(".price");
        var totalPrice = 0;

        allPrices.forEach(priceElement => {
            var text = priceElement.textContent.replace('$', '').trim();
            var p = parseFloat(text);
            if (!isNaN(p)) {
                totalPrice += p;
            }
        });

        if (total) total.textContent = `$ ${totalPrice}`;
        showEmptyBagNoticeIfNeeded();
    }

    function checkOrderForm() {
        var total = document.getElementById("total");
        var errorBox = document.getElementById("orderValidationError");
        var tableNoInput = document.getElementById("tableNo");
        var customerNameInput = document.getElementById("customerName");

        var totalPrice = parseFloat(total.textContent.replace('$', '').trim()) || 0;

        if (totalPrice <= 0 || addedProducts.length === 0) {
            if (errorBox) {
                errorBox.textContent = "⚠️ Vui lòng chọn ít nhất một món trước khi đặt hàng!";
                errorBox.style.display = "block";
            }
            alert("Vui lòng chọn ít nhất một món trước khi đặt hàng!");
            return false;
        }

        var tableNo = parseInt(tableNoInput.value);
        if (isNaN(tableNo) || tableNo <= 0) {
            if (errorBox) {
                errorBox.textContent = "⚠️ Số bàn phải lớn hơn 0!";
                errorBox.style.display = "block";
            }
            tableNoInput.focus();
            return false;
        }

        var customerName = (customerNameInput.value || "").trim();
        if (customerName.length === 0) {
            if (errorBox) {
                errorBox.textContent = "⚠️ Tên khách hàng không được để trống!";
                errorBox.style.display = "block";
            }
            customerNameInput.focus();
            return false;
        }

        if (customerName.length > 50) {
            if (errorBox) {
                errorBox.textContent = "⚠️ Tên khách hàng không được vượt quá 50 ký tự!";
                errorBox.style.display = "block";
            }
            customerNameInput.focus();
            return false;
        }

        if (errorBox) errorBox.style.display = "none";
        document.getElementById("totalPrice").value = totalPrice;
        window.removeEventListener('beforeunload', UpdateDBBefore);
        return true;
    }
</script>
