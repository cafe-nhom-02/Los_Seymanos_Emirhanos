@model IEnumerable<Order>

@{
    ViewData["Header"] = "Danh sách đơn hàng";
    ViewBag.Title = "Danh sách đơn hàng";
}

<!-- Phần hiển thị tổng số đơn và tổng tiền ở đầu trang (Tiếng Việt có dấu) -->
<div style="display: flex; width: 55%; justify-content: space-around; margin: 0 auto 35px auto; padding: 15px; background-color: #fdfdfd; border: 1px solid #ddd; border-radius: 12px; font-family: 'Raleway', sans-serif;">
    <div style="text-align: center;">
        <div style="font-size: 16px; color: #555; margin-bottom: 5px;">Tổng đơn đã thanh toán</div>
        <div style="font-size: 22px; font-weight: bold; color: #2E2928;">@ViewBag.TotalPaidOrders</div>
    </div>
    <div style="border-left: 1px solid #ccc;"></div>
    <div style="text-align: center;">
        <div style="font-size: 16px; color: #555; margin-bottom: 5px;">Tổng tiền doanh thu</div>
        <div style="font-size: 22px; font-weight: bold; color: #b80f2b;">@string.Format("{0:N0}", ViewBag.TotalRevenue) VNĐ</div>
    </div>
</div>
<div style="display: flex; width: 55%; justify-content: space-between; margin: 0 auto; font-size: 24px;">

    <div style="text-align: center;">
        <div style="margin-bottom: 45px; font-weight: bold; border-bottom: 1px solid;">Giờ đặt</div>

        @foreach (var order in Model)
        {
            <div style="margin-bottom: 30px;">
                @{
                    int hours = order.OrderDate.Hour;
                    int minutes = order.OrderDate.Minute;

                    string formattedHours = hours < 10 ? "0" + hours.ToString() : hours.ToString();
                    string formattedMinutes = minutes < 10 ? "0" + minutes.ToString() : minutes.ToString();

                    string currentTimeString = formattedHours + ":" + formattedMinutes;
                }
                @currentTimeString
            </div>
        }
    </div>

    <div style="text-align: center;">
        <div style="margin-bottom: 45px; font-weight: bold; border-bottom: 1px solid;">Số bàn</div>

        @foreach (var order in Model)
        {
            <div style="margin-bottom: 30px;">
                @order.TableNo
            </div>
        }
    </div>
    
    <div style="text-align: center;">
        <div style="margin-bottom: 45px; font-weight: bold; border-bottom: 1px solid;">Tên khách hàng</div>
        @foreach (var order in Model)
        {
            <div style="margin-bottom: 30px;">
                @order.CustomerName
            </div>
        }
    </div>

    <div style="text-align: center;">
        <div style="margin-bottom: 45px; font-weight: bold; border-bottom: 1px solid;">Trạng thái phục vụ</div>
        @foreach (var order in Model)
        {
            <div style="margin-bottom: 30px;">
                <input style="width: 30px; height: 30px; cursor: pointer;" type="checkbox" name="IsServed" value="true"
                @(order.IsServed ? "checked='checked'" : "") disabled />
            </div>
        }
    </div>

    <div style="text-align: center;">
        <div style="margin-bottom: 45px; font-weight: bold; border-bottom: 1px solid;">Trạng thái thanh toán</div>
        @foreach (var order in Model)
        {
            <div style="margin-bottom: 30px;">
                <input style="width: 30px; height: 30px; cursor: pointer;" type="checkbox" name="IsServed" value="true"
                @(order.IsPaid ? "checked='checked'" : "") disabled />
            </div>
        }
    </div>

    <div style="text-align: center;">
        <div style="margin-bottom: 45px; font-weight: bold; border-bottom: 1px solid; opacity: 0;">Cập nhật</div>
        @foreach (var order in Model)
        {
            <div style="margin-bottom: 30px;">
                <a asp-controller="Barista" asp-action="OrderDetails" asp-route-id="@order.OrderId" style="text-decoration: none;
                        color: #F8F8F8;
                        background-color: #2E2928;
                        font-family: 'Raleway', sans-serif;
                        padding: 10px 13px;
                        border-radius: 14px; margin-right: 15px;
                        transition: all 0.3s;" onmouseover="this.style.opacity=0.8"
                    onmouseout="this.style.opacity=1">Chi tiết</a>
                <a asp-controller="Barista" asp-action="Delete" asp-route-id="@order.OrderId" style="text-decoration: none;
                        color: #F8F8F8;
                        background-color: #b80f2b;
                        font-family: 'Raleway', sans-serif;
                        padding: 10px 13px;
                        border-radius: 14px;
                        transition: all 0.3s;" onmouseover="this.style.opacity=0.8"
                    onmouseout="this.style.opacity=1">Xóa</a>
            </div>
        }
    </div>
</div>
<div style="height: 15vh;"></div>
