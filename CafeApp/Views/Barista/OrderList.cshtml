@model IEnumerable<Order>

@{
    ViewData["Header"] = "Quản Lý Đơn Hàng";
    ViewBag.Title = "Danh sách đơn hàng";
    var totalOrdersCount = Model?.Count() ?? 0;
}

<!-- Dashboard Thống Kê Nhanh -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 30px;">
    <!-- Thẻ 1: Tổng đơn -->
    <div class="modern-card" style="padding: 20px; display: flex; align-items: center; gap: 18px;">
        <div style="width: 52px; height: 52px; border-radius: 14px; background: #FAF0E6; color: #C78C58; display: flex; align-items: center; justify-content: center; font-size: 26px;">
            📋
        </div>
        <div>
            <div style="font-size: 13px; color: var(--text-secondary); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Tổng đơn tiếp nhận</div>
            <div style="font-size: 26px; font-weight: 800; color: var(--primary-espresso);">@totalOrdersCount</div>
        </div>
    </div>

    <!-- Thẻ 2: Đơn đã thanh toán -->
    <div class="modern-card" style="padding: 20px; display: flex; align-items: center; gap: 18px;">
        <div style="width: 52px; height: 52px; border-radius: 14px; background: #E8F8F0; color: #16A34A; display: flex; align-items: center; justify-content: center; font-size: 26px;">
            ✅
        </div>
        <div>
            <div style="font-size: 13px; color: var(--text-secondary); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Đơn đã thanh toán</div>
            <div style="font-size: 26px; font-weight: 800; color: #15803D;">@ViewBag.TotalPaidOrders</div>
        </div>
    </div>

    <!-- Thẻ 3: Tổng doanh thu -->
    <div class="modern-card" style="padding: 20px; display: flex; align-items: center; gap: 18px;">
        <div style="width: 52px; height: 52px; border-radius: 14px; background: #FDF2F2; color: #A8202A; display: flex; align-items: center; justify-content: center; font-size: 26px;">
            💰
        </div>
        <div>
            <div style="font-size: 13px; color: var(--text-secondary); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Tổng doanh thu</div>
            <div style="font-size: 24px; font-weight: 800; color: #A8202A;">@string.Format("{0:N0}", ViewBag.TotalRevenue) VNĐ</div>
        </div>
    </div>
</div>

<!-- Bảng Danh Sách Đơn Hàng -->
<div class="modern-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2 style="font-size: 18px; margin: 0; color: var(--primary-espresso);">Danh Sách Đơn Gọi Món Mới Nhất</h2>
            <p style="margin: 3px 0 0 0; font-size: 13px; color: var(--text-secondary);">Cập nhật trạng thái pha chế và thanh toán đơn hàng tại quán</p>
        </div>
        <a asp-action="OrderList" class="btn-coffee-secondary" style="font-size: 13px; padding: 7px 16px;">
            <span>🔄</span> Làm mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 60px 20px;">
            <div style="font-size: 48px; margin-bottom: 15px;">☕</div>
            <h3 style="font-size: 20px; color: var(--text-secondary); margin-bottom: 8px;">Hiện Chưa Có Đơn Hàng Nào</h3>
            <p style="color: var(--text-muted); font-size: 14px; max-width: 400px; margin: 0 auto;">Khi khách hàng đặt món tại bàn, các đơn hàng sẽ tự động xuất hiện tại đây.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th style="width: 80px;">Mã đơn</th>
                        <th style="width: 110px;">Giờ đặt</th>
                        <th style="width: 100px; text-align: center;">Số bàn</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th style="text-align: center;">Phục vụ</th>
                        <th style="text-align: center;">Thanh toán</th>
                        <th style="text-align: right; width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <strong style="color: var(--primary-mocha);">#@order.OrderId</strong>
                            </td>
                            <td>
                                <span style="display: inline-flex; align-items: center; gap: 4px; font-weight: 600; color: var(--text-secondary);">
                                    🕒 @order.OrderDate.ToString("HH:mm")
                                </span>
                            </td>
                            <td style="text-align: center;">
                                <span class="badge-custom badge-table">
                                    Bàn @(order.TableNo?.ToString() ?? "-")
                                </span>
                            </td>
                            <td>
                                <strong style="color: var(--text-primary);">@(order.CustomerName ?? "Khách lẻ")</strong>
                            </td>
                            <td>
                                <span style="font-weight: 700; color: #A8202A;">$@order.TotalPrice</span>
                            </td>
                            <td style="text-align: center;">
                                @if (order.IsServed)
                                {
                                    <span class="badge-custom badge-success">
                                        <span>✓</span> Đã phục vụ
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-custom badge-warning">
                                        <span>⏳</span> Đang chuẩn bị
                                    </span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @if (order.IsPaid)
                                {
                                    <span class="badge-custom badge-success">
                                        <span>✓</span> Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-custom badge-danger">
                                        <span>✕</span> Chưa trả
                                    </span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 8px;">
                                    <a asp-controller="Barista" asp-action="OrderDetails" asp-route-id="@order.OrderId" 
                                       class="btn-coffee-primary" style="padding: 7px 14px; font-size: 13px;" title="Xem và cập nhật đơn">
                                        <span>📝</span> Chi tiết
                                    </a>
                                    <a asp-controller="Barista" asp-action="Delete" asp-route-id="@order.OrderId" 
                                       class="btn-coffee-danger" style="padding: 7px 12px; font-size: 13px;" title="Xóa đơn hàng">
                                        <span>🗑️</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
