@model CafeApp.Models.Order

@{
    ViewData["Header"] = "Xác Nhận Xóa Đơn Hàng";
    ViewBag.Title = "Xác nhận xóa đơn";
}

<div style="max-width: 520px; margin: 40px auto;">
    <div class="modern-card" style="text-align: center; padding: 40px 30px;">
        <div style="width: 72px; height: 72px; border-radius: 50%; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 36px; margin: 0 auto 20px auto;">
            ⚠️
        </div>

        <h2 style="font-size: 22px; margin-bottom: 12px; color: var(--primary-espresso);">
            Xác nhận xóa đơn hàng #@Model.OrderId?
        </h2>

        <p style="color: var(--text-secondary); font-size: 15px; margin-bottom: 24px; line-height: 1.5;">
            Bạn có chắc chắn muốn xóa vĩnh viễn đơn hàng của quý khách <strong>@(Model.CustomerName ?? "Khách lẻ")</strong> 
            tại <strong>Bàn @(Model.TableNo?.ToString() ?? "-")</strong> với tổng số tiền <strong>$@Model.TotalPrice</strong>?
            Hành động này không thể hoàn tác.
        </p>

        <form asp-action="Delete" method="post" style="display: flex; gap: 14px; justify-content: center;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" asp-for="@Model.OrderId" />
            
            <a asp-action="OrderList" class="btn-coffee-secondary" style="flex: 1; max-width: 160px;">
                Không, giữ lại
            </a>
            <button type="submit" class="btn-coffee-danger" style="flex: 1; max-width: 160px;">
                <span>🗑️</span> Có, xóa đơn
            </button>
        </form>
    </div>
</div>
