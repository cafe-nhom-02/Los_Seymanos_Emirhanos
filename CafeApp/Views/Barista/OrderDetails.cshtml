@model Tuple<Order, List<Product>, List<int>, Dictionary<int, int>>

@{
    ViewData["Header"] = "Chi Tiết Đơn Hàng #" + Model.Item1.OrderId;
    ViewBag.Title = "Chi tiết đơn hàng";
}

<div style="max-width: 820px; margin: 20px auto;">
    <div class="modern-card" style="padding: 32px;">
        <!-- Header thông tin đơn -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 24px; border-bottom: 1.5px dashed var(--border-color); flex-wrap: wrap; gap: 16px;">
            <div>
                <span class="badge-custom badge-table" style="font-size: 15px; padding: 6px 16px; margin-bottom: 10px; display: inline-block;">
                    Bàn số @Model.Item1.TableNo
                </span>
                <h2 style="font-size: 24px; margin: 0 0 4px 0; color: var(--primary-espresso);">Khách hàng: @Model.Item1.CustomerName</h2>
                <div style="color: var(--text-secondary); font-size: 14px;">
                    🕒 Giờ đặt món: <strong>@Model.Item1.OrderDate.ToString("HH:mm - dd/MM/yyyy")</strong>
                </div>
            </div>

            <div style="text-align: right;">
                <div style="font-size: 13px; color: var(--text-secondary); text-transform: uppercase; font-weight: 700;">Tổng thanh toán</div>
                <div style="font-size: 32px; font-weight: 800; color: #A8202A;">$@Model.Item1.TotalPrice</div>
            </div>
        </div>

        <!-- Danh sách món đã chọn -->
        <div style="margin: 28px 0;">
            <h3 style="font-size: 18px; margin-bottom: 16px; color: var(--primary-mocha); display: flex; align-items: center; gap: 8px;">
                <span>🍽️</span> Danh Sách Món Khách Đã Chọn
            </h3>

            <div class="table-responsive">
                <table class="table-modern" style="border: 1px solid var(--border-color); border-radius: var(--radius-md);">
                    <thead>
                        <tr>
                            <th>Tên món</th>
                            <th style="text-align: center; width: 100px;">Số lượng</th>
                            <th style="text-align: right; width: 120px;">Đơn giá</th>
                            <th style="text-align: right; width: 140px;">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Item2)
                        {
                            var qty = Model.Item4.ContainsKey(product.ProductId) ? Model.Item4[product.ProductId] : 0;
                            var subtotal = (product.Price ?? 0) * qty;
                            <tr>
                                <td>
                                    <strong style="color: var(--primary-mocha);">@product.Name</strong>
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge-custom badge-info">@qty</span>
                                </td>
                                <td style="text-align: right; color: var(--text-secondary);">
                                    $@product.Price
                                </td>
                                <td style="text-align: right; font-weight: 700; color: #A8202A;">
                                    $@subtotal
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Form Cập nhật trạng thái -->
        <form asp-controller="Order" asp-action="UpdateOrderStatus" method="post" style="background: #FAF7F2; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.Item1.OrderId" />

            <h3 style="font-size: 16px; margin-bottom: 18px; color: var(--primary-espresso); font-family: var(--font-body); font-weight: 700;">
                ⚙️ Cập nhật tiến độ đơn hàng
            </h3>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
                <!-- Trạng thái phục vụ -->
                <label style="display: flex; align-items: center; gap: 14px; background: #FFFFFF; padding: 16px; border-radius: 12px; border: 1.5px solid var(--border-color); cursor: pointer; transition: all 0.2s;">
                    <input type="checkbox" name="isServed" value="true" @(Model.Item1.IsServed ? "checked='checked'" : "") style="width: 22px; height: 22px; accent-color: #16A34A; cursor: pointer;" />
                    <div>
                        <strong style="font-size: 15px; color: var(--primary-espresso); display: block;">Đã phục vụ tại bàn</strong>
                        <span style="font-size: 12.5px; color: var(--text-secondary);">Món đã được mang ra cho khách</span>
                    </div>
                </label>

                <!-- Trạng thái thanh toán -->
                <label style="display: flex; align-items: center; gap: 14px; background: #FFFFFF; padding: 16px; border-radius: 12px; border: 1.5px solid var(--border-color); cursor: pointer; transition: all 0.2s;">
                    <input type="checkbox" name="isPaid" value="true" @(Model.Item1.IsPaid ? "checked='checked'" : "") style="width: 22px; height: 22px; accent-color: #16A34A; cursor: pointer;" />
                    <div>
                        <strong style="font-size: 15px; color: var(--primary-espresso); display: block;">Đã thu tiền</strong>
                        <span style="font-size: 12.5px; color: var(--text-secondary);">Khách đã thanh toán hóa đơn</span>
                    </div>
                </label>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <a asp-action="OrderList" class="btn-coffee-secondary">
                    ← Quay lại danh sách
                </a>
                <button type="submit" class="btn-coffee-primary">
                    <span>💾</span> Lưu cập nhật trạng thái
                </button>
            </div>
        </form>
    </div>
</div>
