@model CafeApp.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm mới";
    ViewData["Header"] = "Thêm Sản Phẩm Mới";
}

<div style="max-width: 600px; margin: 20px auto;">
    <div class="modern-card">
        <div style="margin-bottom: 24px; text-align: center;">
            <div style="font-size: 38px; margin-bottom: 8px;">☕</div>
            <h2 style="font-size: 24px; margin-bottom: 6px;">Thêm Món Mới Vào Menu</h2>
            <p style="color: var(--text-secondary); font-size: 14px; margin: 0;">Điền thông tin chi tiết về sản phẩm để phục vụ quý khách hàng.</p>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-error mb-3"></div>

            <div style="margin-bottom: 18px;">
                <label class="form-label-custom" asp-for="Name">Tên món đồ uống / bánh ngọt *</label>
                <input class="form-control-custom" asp-for="Name" placeholder="Ví dụ: Cà phê Muối Hải Phòng" required />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label class="form-label-custom" asp-for="ImageSrc">Đường dẫn hình ảnh *</label>
                <input class="form-control-custom" asp-for="ImageSrc" placeholder="Ví dụ: /images/cappuccino.jpg" required />
                <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 4px;">
                    💡 Gợi ý ảnh có sẵn: /images/cappuccino.jpg, /images/latte.jpg, /images/americano.jpg, /images/caffe_mocha.jpg, /images/chocolate_croissant.jpg
                </span>
                <span asp-validation-for="ImageSrc" class="validation-error"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label class="form-label-custom" asp-for="Details">Mô tả món</label>
                <textarea class="form-control-custom" asp-for="Details" rows="3" placeholder="Hương vị đậm đà, thơm béo quyến rũ..."></textarea>
                <span asp-validation-for="Details" class="validation-error"></span>
            </div>

            <div style="margin-bottom: 26px;">
                <label class="form-label-custom" asp-for="Price">Giá bán ($) *</label>
                <input class="form-control-custom" asp-for="Price" type="number" step="1" min="1" placeholder="Ví dụ: 35" required />
                <span asp-validation-for="Price" class="validation-error"></span>
            </div>

            <div style="display: flex; gap: 14px; justify-content: flex-end;">
                <a asp-action="ProductList" asp-controller="Barista" class="btn-coffee-secondary">
                    Quay lại
                </a>
                <button type="submit" class="btn-coffee-primary">
                    <span>➕</span> Tạo sản phẩm
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
