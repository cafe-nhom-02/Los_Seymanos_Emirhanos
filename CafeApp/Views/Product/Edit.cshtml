@model CafeApp.Models.Product

@{
    ViewBag.Title = "Chỉnh sửa sản phẩm";
    ViewData["Header"] = "Chỉnh Sửa Món";
}

<div style="max-width: 600px; margin: 20px auto;">
    <div class="modern-card">
        <div style="margin-bottom: 24px; text-align: center;">
            <div style="font-size: 38px; margin-bottom: 8px;">✏️</div>
            <h2 style="font-size: 24px; margin-bottom: 6px;">Cập Nhật Thông Tin Sản Phẩm</h2>
            <p style="color: var(--text-secondary); font-size: 14px; margin: 0;">Mã sản phẩm: #@Model.ProductId</p>
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />
            <div asp-validation-summary="ModelOnly" class="validation-error mb-3"></div>

            <div style="margin-bottom: 18px;">
                <label class="form-label-custom" asp-for="Name">Tên món đồ uống / bánh ngọt *</label>
                <input class="form-control-custom" asp-for="Name" placeholder="Tên món" required />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label class="form-label-custom" asp-for="ImageSrc">Đường dẫn hình ảnh *</label>
                <input class="form-control-custom" asp-for="ImageSrc" placeholder="/images/latte.jpg" required />
                <span asp-validation-for="ImageSrc" class="validation-error"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label class="form-label-custom" asp-for="Details">Mô tả món</label>
                <textarea class="form-control-custom" asp-for="Details" rows="3" placeholder="Mô tả hương vị..."></textarea>
                <span asp-validation-for="Details" class="validation-error"></span>
            </div>

            <div style="margin-bottom: 26px;">
                <label class="form-label-custom" asp-for="Price">Giá bán ($) *</label>
                <input class="form-control-custom" asp-for="Price" type="number" step="1" min="1" placeholder="35" required />
                <span asp-validation-for="Price" class="validation-error"></span>
            </div>

            <div style="display: flex; gap: 14px; justify-content: flex-end;">
                <a asp-action="ProductList" asp-controller="Barista" class="btn-coffee-secondary">
                    Hủy bỏ
                </a>
                <button type="submit" class="btn-coffee-primary">
                    <span>💾</span> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
